# Store text with LF line endings in the repository and working copy.
# Keeps shell scripts and service files deployable to the Linux VPS, and avoids CRLF warnings.
* text=auto eol=lf

*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.pptx binary
*.docx binary
*.sqlite binary
*.tar.gz binary
